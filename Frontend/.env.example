# Frontend environment variables (copy to .env.local and fill in your own keys)

# Google Gemini API key (used for AI movie recommendations)
VITE_GOOGLE_GENAI_API_KEY=your_gemini_api_key

# TMDB (The Movie Database) access token - only the token, no "Bearer " prefix
# Get one from: https://www.themoviedb.org/settings/api
VITE_TMDB_ACCESS_TOKEN=your_tmdb_read_access_token

# Backend API URL (blank falls back to same-origin, e.g. the Vite /api proxy)
VITE_API_URL=http://localhost:5000
